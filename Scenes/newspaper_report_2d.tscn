[sub_resource type="Shader" id="Shader_newsprint_photo"]
code = "shader_type canvas_item;\n\nuniform float ink_strength : hint_range(0.0, 1.0) = 0.72;\nuniform float halftone_strength : hint_range(0.0, 0.3) = 0.10;\nuniform float grain_strength : hint_range(0.0, 0.2) = 0.045;\n\nfloat random_noise(vec2 position) {\n\treturn fract(sin(dot(position, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nvoid fragment() {\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat gray = dot(source.rgb, vec3(0.299, 0.587, 0.114));\n\tvec3 sepia = vec3(gray * 1.08, gray * 0.94, gray * 0.74);\n\tvec2 print_position = floor(FRAGCOORD.xy * 0.55);\n\tfloat dots = sin(print_position.x * 3.14159) * sin(print_position.y * 3.14159);\n\tfloat grain = random_noise(floor(FRAGCOORD.xy));\n\tvec3 printed = mix(source.rgb, sepia, ink_strength);\n\tprinted *= 1.0 - halftone_strength * (0.5 + 0.5 * dots);\n\tprinted += (grain - 0.5) * grain_strength;\n\tfloat edge = 1.0 - smoothstep(0.20, 0.72, distance(UV, vec2(0.5)));\n\tprinted *= mix(0.82, 1.0, edge);\n\tCOLOR = vec4(printed, source.a);\n}\n"

