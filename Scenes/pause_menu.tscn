[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/UI/PauseMenu.gd" id="1_script"]

[sub_resource type="Shader" id="Shader_pause_blur"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;\nuniform float blur_strength : hint_range(0.0, 5.0) = 2.2;\n\nvoid fragment() {\n    vec4 blurred = textureLod(screen_texture, SCREEN_UV, blur_strength);\n    COLOR = vec4(blurred.rgb * vec3(0.38, 0.32, 0.25), 1.0);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_pause_blur"]
shader = SubResource("Shader_pause_blur")

