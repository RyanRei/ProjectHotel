;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectHotel"
run/main_scene="res://Scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DayReportManager="*uid://b264q5evjd2ky"
DialogueManager="*uid://wqjrphcvmu8g"
GameState="*uid://big8p5bq03poy"
TimeManager="*res://Scripts/Managers/TimeManager.gd"
MusicManager="*res://Scripts/Managers/MusicManager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray()

